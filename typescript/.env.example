NODE_ENV=development
PORT=3000
APP_SECURITY_ENABLED=false
APP_JWT_SECRET=replace_with_32_bytes_min_secret
APP_JWT_EXPIRE_MINUTES=120
APP_REFRESH_EXPIRE_DAYS=14
APP_DEMO_API_KEY=local-demo-api-key
APP_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173
APP_INGESTION_STORAGE_DIR=./data/uploads
APP_INGESTION_QUEUE_BACKEND=in-memory
APP_REDIS_URL=redis://localhost:6380
APP_REDIS_STREAM_KEY=knowledgeops:ingestion
APP_REDIS_CONSUMER_GROUP=knowledgeops-workers
APP_REDIS_CONSUMER_NAME=worker-1
APP_INGESTION_WORKER_ENABLED=false
APP_INGESTION_WORKER_INTERVAL_MS=2000
APP_INGESTION_WORKER_CONCURRENCY=2
APP_INGESTION_MAX_FILE_BYTES=20971520
APP_ALLOWED_UPLOAD_MIME_TYPES=text/plain,text/markdown,application/pdf,application/octet-stream
APP_INGESTION_MAX_RETRIES=3
APP_INGESTION_BASE_DELAY_SECONDS=30
APP_STATE_FILE=./data/state.json
APP_WORKSPACE_ROOT=..
APP_PRISMA_ENABLED=false
DATABASE_URL=mysql://root:root@localhost:3307/knowledgeops_agent
APP_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
APP_LLM_TIMEOUT_MS=30000
APP_LLM_MAX_RETRIES=2
APP_LLM_TEMPERATURE=0.2
APP_MODEL_ECONOMY=gpt-4.1-mini
APP_MODEL_BALANCED=gpt-4.1
APP_MODEL_QUALITY=gpt-4.1
APP_MODEL_DEFAULT_PROFILE=balanced
APP_MODEL_AB_QUALITY_PERCENT=50
APP_VECTOR_BACKEND=local
APP_PGVECTOR_ENDPOINT=
APP_EMBEDDING_ENABLED=false
APP_EMBEDDING_MODEL=text-embedding-3-small
APP_EMBEDDING_BASE_URL=https://api.openai.com/v1
APP_WEB_SEARCH_ENABLED=false
APP_WEB_SEARCH_ENDPOINT=
APP_WEB_SEARCH_TIMEOUT_MS=8000
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_CAPACITY=120
APP_RATE_LIMIT_REFILL_SECONDS=60
APP_DISTRIBUTED_RATE_LIMIT_ENABLED=false
APP_AUDIT_RETENTION_DAYS=90
APP_OBSERVABILITY_TRACE_ENABLED=false
APP_WORKFLOW_ASYNC_ENABLED=false
APP_WORKFLOW_WORKER_INTERVAL_MS=2000
APP_MCP_HTTP_ALLOWLIST=
