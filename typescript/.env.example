NODE_ENV=development
PORT=3000
APP_SECURITY_ENABLED=false
APP_JWT_SECRET=replace_with_32_bytes_min_secret
APP_JWT_EXPIRE_MINUTES=120
APP_REFRESH_EXPIRE_DAYS=14
APP_DEMO_API_KEY=local-demo-api-key
APP_CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:5173
APP_INGESTION_STORAGE_DIR=./data/uploads
APP_INGESTION_QUEUE_BACKEND=in-memory
APP_INGESTION_MAX_RETRIES=3
APP_INGESTION_BASE_DELAY_SECONDS=30
APP_STATE_FILE=./data/state.json
APP_WORKSPACE_ROOT=..
APP_LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
APP_MODEL_ECONOMY=gpt-4.1-mini
APP_MODEL_BALANCED=gpt-4.1
APP_MODEL_QUALITY=gpt-4.1
APP_MODEL_DEFAULT_PROFILE=balanced
APP_MODEL_AB_QUALITY_PERCENT=50
APP_WEB_SEARCH_ENABLED=false
APP_WEB_SEARCH_ENDPOINT=
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_CAPACITY=120
APP_RATE_LIMIT_REFILL_SECONDS=60
APP_AUDIT_RETENTION_DAYS=90
APP_COST_ENABLED=true
APP_COST_DEFAULT_MONTHLY_BUDGET_USD=25
APP_COST_DEFAULT_HARD_LIMIT_ENABLED=false
APP_COST_TOKEN_ESTIMATE_DIVISOR=4
APP_COST_USD_PER_1K_LOW=0.001
APP_COST_USD_PER_1K_BALANCED=0.003
APP_COST_USD_PER_1K_HIGH=0.008
RAG_CHUNK_SIZE=800
RAG_MIN_CHUNK_SIZE=80
RAG_MAX_NUM_CHUNKS=200
RAG_SIMILARITY_THRESHOLD=0.05
RAG_RETRIEVE_TOP_K=8
