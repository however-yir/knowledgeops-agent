generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Course {
  id       Int     @id @default(autoincrement())
  name     String  @db.VarChar(128)
  edu      Int?
  type     String? @db.VarChar(32)
  price    BigInt?
  duration Int?

  @@map("course")
}

model School {
  id   Int     @id @default(autoincrement())
  name String  @db.VarChar(128)
  city String? @db.VarChar(64)

  @@map("school")
}

model CourseReservation {
  id          Int     @id @default(autoincrement())
  course      String  @db.VarChar(128)
  studentName String  @map("student_name") @db.VarChar(64)
  contactInfo String  @map("contact_info") @db.VarChar(128)
  school      String  @db.VarChar(128)
  remark      String? @db.VarChar(255)

  @@map("course_reservation")
}

model Conversation {
  id             BigInt   @id
  tenantId       String   @default("public") @map("tenant_id") @db.VarChar(64)
  conversationId String   @map("conversation_id") @db.VarChar(128)
  message        String   @db.Text
  type           String   @db.VarChar(32)
  createTime     DateTime @map("create_time")

  @@index([tenantId, conversationId, createTime], map: "idx_conversation_tenant_conversation_create")
  @@map("conversation")
}

model User {
  id           BigInt   @id @default(autoincrement())
  username     String   @unique @db.VarChar(128)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  enabled      Boolean  @default(true)
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")

  @@map("users")
}

model Role {
  id        BigInt   @id @default(autoincrement())
  roleName  String   @unique @map("role_name") @db.VarChar(64)
  createdAt DateTime @map("created_at")

  @@map("roles")
}

model Permission {
  id             BigInt   @id @default(autoincrement())
  permissionName String   @unique @map("permission_name") @db.VarChar(128)
  createdAt      DateTime @map("created_at")

  @@map("permissions")
}

model UserRole {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  roleId    BigInt   @map("role_id")
  createdAt DateTime @map("created_at")

  @@unique([userId, roleId], map: "uk_user_role")
  @@map("user_roles")
}

model RolePermission {
  id           BigInt   @id @default(autoincrement())
  roleId       BigInt   @map("role_id")
  permissionId BigInt   @map("permission_id")
  createdAt    DateTime @map("created_at")

  @@unique([roleId, permissionId], map: "uk_role_permission")
  @@map("role_permissions")
}

model ApiKey {
  id            BigInt    @id @default(autoincrement())
  keyHash       String    @unique @map("key_hash") @db.VarChar(128)
  keyName       String    @map("key_name") @db.VarChar(128)
  roleName      String    @map("role_name") @db.VarChar(64)
  tenantId      String    @default("public") @map("tenant_id") @db.VarChar(64)
  enabled       Boolean   @default(true)
  lastUsedAt    DateTime? @map("last_used_at")
  expiresAt     DateTime? @map("expires_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason") @db.VarChar(255)
  rotatedFromId BigInt?   @map("rotated_from_id")
  createdAt     DateTime  @map("created_at")
  updatedAt     DateTime  @map("updated_at")

  @@index([enabled, expiresAt, revokedAt], map: "idx_api_keys_expire_revoke")
  @@index([keyName, enabled, revokedAt, expiresAt], map: "idx_api_keys_key_name_active")
  @@index([tenantId, keyName, enabled, revokedAt, expiresAt], map: "idx_api_keys_tenant_key_name_active")
  @@map("api_keys")
}

model RefreshToken {
  id        BigInt    @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  principal String    @db.VarChar(255)
  roles     String    @db.VarChar(255)
  tenantId  String    @default("public") @map("tenant_id") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @map("created_at")

  @@index([principal, expiresAt], map: "idx_refresh_tokens_principal")
  @@index([tenantId, principal, expiresAt], map: "idx_refresh_tokens_tenant_principal")
  @@map("refresh_tokens")
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  requestId     String?  @map("request_id") @db.VarChar(128)
  traceId       String?  @map("trace_id") @db.VarChar(128)
  tenantId      String   @default("public") @map("tenant_id") @db.VarChar(64)
  userIdentity  String?  @map("user_identity") @db.VarChar(255)
  method        String   @db.VarChar(16)
  path          String   @db.VarChar(255)
  statusCode    Int      @map("status_code")
  durationMs    BigInt   @map("duration_ms")
  chatId        String?  @map("chat_id") @db.VarChar(128)
  jobId         String?  @map("job_id") @db.VarChar(128)
  extraPayload  String?  @map("extra_payload") @db.Text
  createdAt     DateTime @map("created_at")

  @@index([createdAt], map: "idx_audit_created")
  @@index([tenantId, createdAt], map: "idx_audit_tenant_created")
  @@map("audit_log")
}

model IngestionJob {
  id             BigInt    @id @default(autoincrement())
  jobId          String    @unique @map("job_id") @db.VarChar(64)
  tenantId       String    @default("public") @map("tenant_id") @db.VarChar(64)
  chatId         String    @map("chat_id") @db.VarChar(128)
  sourceType     String    @map("source_type") @db.VarChar(32)
  sourceName     String    @map("source_name") @db.VarChar(255)
  filePath       String    @map("file_path") @db.VarChar(512)
  idempotencyKey String    @map("idempotency_key") @db.VarChar(128)
  status         String    @db.VarChar(32)
  traceId        String?   @map("trace_id") @db.VarChar(128)
  attemptCount   Int       @default(0) @map("attempt_count")
  maxRetries     Int       @default(3) @map("max_retries")
  errorMessage   String?   @map("error_message") @db.VarChar(1024)
  nextRetryAt    DateTime? @map("next_retry_at")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @map("created_at")
  updatedAt      DateTime  @map("updated_at")

  @@unique([tenantId, idempotencyKey], map: "uk_ingestion_tenant_idempotency")
  @@index([status, nextRetryAt], map: "idx_ingestion_status_next_retry")
  @@index([chatId, createdAt], map: "idx_ingestion_chat_created")
  @@index([tenantId, chatId, createdAt], map: "idx_ingestion_tenant_chat_created")
  @@index([tenantId, status, nextRetryAt], map: "idx_ingestion_tenant_status_next_retry")
  @@map("ingestion_job")
}

model AgentSessionState {
  id             BigInt   @id @default(autoincrement())
  sessionId      String   @map("session_id") @db.VarChar(128)
  tenantId       String   @default("public") @map("tenant_id") @db.VarChar(64)
  title          String   @db.VarChar(255)
  workspaceId    String   @default("default") @map("workspace_id") @db.VarChar(64)
  modelProfile   String   @default("balanced") @map("model_profile") @db.VarChar(32)
  streaming      Boolean  @default(true)
  pinned         Boolean  @default(false)
  archived       Boolean  @default(false)
  activeBranchId String?  @map("active_branch_id") @db.VarChar(128)
  sessionPayload String   @map("session_payload") @db.LongText
  createdAt      DateTime @map("created_at")
  updatedAt      DateTime @map("updated_at")

  @@unique([tenantId, sessionId], map: "uk_agent_session_tenant_session")
  @@index([tenantId, updatedAt], map: "idx_agent_session_tenant_updated")
  @@index([tenantId, pinned, archived, updatedAt], map: "idx_agent_session_tenant_pin_archive_updated")
  @@map("agent_session_state")
}

model AnswerFeedback {
  id           BigInt   @id @default(autoincrement())
  tenantId     String   @default("public") @map("tenant_id") @db.VarChar(64)
  chatId       String   @map("chat_id") @db.VarChar(128)
  sessionId    String?  @map("session_id") @db.VarChar(128)
  branchId     String?  @map("branch_id") @db.VarChar(128)
  messageId    String?  @map("message_id") @db.VarChar(128)
  rating       Int
  comment      String?  @db.VarChar(1024)
  questionText String?  @map("question_text") @db.Text
  answerText   String?  @map("answer_text") @db.Text
  createdAt    DateTime @map("created_at")

  @@index([tenantId, createdAt], map: "idx_answer_feedback_tenant_created")
  @@map("answer_feedback")
}

model TenantBudget {
  id               BigInt   @id @default(autoincrement())
  tenantId         String   @unique(map: "uk_tenant_budget_tenant") @map("tenant_id") @db.VarChar(64)
  monthlyBudgetUsd Decimal  @default(25.0000) @map("monthly_budget_usd") @db.Decimal(12, 4)
  hardLimitEnabled Boolean  @default(false) @map("hard_limit_enabled")
  createdAt        DateTime @map("created_at")
  updatedAt        DateTime @map("updated_at")

  @@map("tenant_budget")
}

model TenantUsageDaily {
  id            BigInt   @id @default(autoincrement())
  tenantId      String   @map("tenant_id") @db.VarChar(64)
  usageDate     DateTime @map("usage_date") @db.Date
  requestCount  BigInt   @default(0) @map("request_count")
  inputTokens   BigInt   @default(0) @map("input_tokens")
  outputTokens  BigInt   @default(0) @map("output_tokens")
  totalCostUsd  Decimal  @default(0.000000) @map("total_cost_usd") @db.Decimal(14, 6)
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")

  @@unique([tenantId, usageDate], map: "uk_tenant_usage_daily_tenant_date")
  @@index([tenantId, usageDate], map: "idx_tenant_usage_daily_tenant_date")
  @@map("tenant_usage_daily")
}

model ModelAbExposure {
  id             BigInt   @id @default(autoincrement())
  tenantId       String   @map("tenant_id") @db.VarChar(64)
  experimentKey  String   @map("experiment_key") @db.VarChar(64)
  subjectKey     String   @map("subject_key") @db.VarChar(128)
  endpoint       String   @db.VarChar(32)
  bucket         Int
  variant        String   @db.VarChar(32)
  routedProfile  String   @map("routed_profile") @db.VarChar(32)
  createdAt      DateTime @map("created_at")

  @@index([tenantId, createdAt], map: "idx_model_ab_exposure_tenant_created")
  @@map("model_ab_exposure")
}

model AgentTask {
  id           BigInt   @id @default(autoincrement())
  taskId       String   @unique(map: "uk_agent_task_id") @map("task_id") @db.VarChar(64)
  tenantId     String   @default("public") @map("tenant_id") @db.VarChar(64)
  type         String   @default("REACT") @db.VarChar(32)
  status       String   @default("CREATED") @db.VarChar(32)
  userInput    String   @map("user_input") @db.Text
  finalOutput  String?  @map("final_output") @db.LongText
  modelProfile String   @default("balanced") @map("model_profile") @db.VarChar(32)
  chatId       String?  @map("chat_id") @db.VarChar(128)
  sessionId    String?  @map("session_id") @db.VarChar(128)
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")

  @@index([tenantId, status], map: "idx_agent_task_tenant_status")
  @@index([tenantId, createdAt], map: "idx_agent_task_tenant_created")
  @@index([sessionId], map: "idx_agent_task_session")
  @@map("agent_task")
}

model AgentStep {
  id              BigInt    @id @default(autoincrement())
  stepId          String    @unique(map: "uk_agent_step_id") @map("step_id") @db.VarChar(64)
  taskId          String    @map("task_id") @db.VarChar(64)
  agentName       String    @default("planner") @map("agent_name") @db.VarChar(64)
  status          String    @default("RUNNING") @db.VarChar(32)
  stepOrder       Int       @default(0) @map("step_order")
  inputJson       Json?     @map("input_json")
  outputJson      Json?     @map("output_json")
  thought         String?   @db.Text
  action          String?   @db.VarChar(64)
  actionInputJson Json?     @map("action_input_json")
  observationJson Json?     @map("observation_json")
  modelProfile    String?   @map("model_profile") @db.VarChar(32)
  inputTokens     BigInt?   @default(0) @map("input_tokens")
  outputTokens    BigInt?   @default(0) @map("output_tokens")
  latencyMs       BigInt?   @default(0) @map("latency_ms")
  errorMessage    String?   @map("error_message") @db.Text
  startedAt       DateTime  @map("started_at")
  endedAt         DateTime? @map("ended_at")

  @@index([taskId], map: "idx_agent_step_task")
  @@index([taskId, stepOrder], map: "idx_agent_step_task_order")
  @@map("agent_step")
}

model AgentEvent {
  id          BigInt   @id @default(autoincrement())
  eventId     String   @unique(map: "uk_agent_event_id") @map("event_id") @db.VarChar(64)
  taskId      String   @map("task_id") @db.VarChar(64)
  stepId      String?  @map("step_id") @db.VarChar(64)
  eventType   String   @map("event_type") @db.VarChar(32)
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @map("created_at")

  @@index([taskId], map: "idx_agent_event_task")
  @@index([taskId, eventType], map: "idx_agent_event_task_type")
  @@index([createdAt], map: "idx_agent_event_created")
  @@map("agent_event")
}

model KgEntity {
  id           BigInt   @id @default(autoincrement())
  entityId     String   @unique(map: "uk_kg_entity_id") @map("entity_id") @db.VarChar(64)
  tenantId     String   @default("public") @map("tenant_id") @db.VarChar(64)
  name         String   @db.VarChar(255)
  type         String   @default("CONCEPT") @db.VarChar(64)
  aliases      Json?
  description  String?  @db.Text
  sourceId     String?  @map("source_id") @db.VarChar(128)
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")

  @@index([tenantId, type], map: "idx_kg_entity_tenant_type")
  @@index([tenantId, name], map: "idx_kg_entity_tenant_name")
  @@map("kg_entity")
}

model KgRelation {
  id             BigInt   @id @default(autoincrement())
  relationId     String   @unique(map: "uk_kg_relation_id") @map("relation_id") @db.VarChar(64)
  tenantId       String   @default("public") @map("tenant_id") @db.VarChar(64)
  sourceEntityId String   @map("source_entity_id") @db.VarChar(64)
  targetEntityId String   @map("target_entity_id") @db.VarChar(64)
  relationType   String   @default("RELATED_TO") @map("relation_type") @db.VarChar(64)
  evidenceId     String?  @map("evidence_id") @db.VarChar(128)
  weight         Float    @default(1.0)
  metadataJson   Json?    @map("metadata_json")
  createdAt      DateTime @map("created_at")

  @@index([tenantId, sourceEntityId], map: "idx_kg_relation_tenant_source")
  @@index([tenantId, targetEntityId], map: "idx_kg_relation_tenant_target")
  @@index([tenantId, relationType], map: "idx_kg_relation_tenant_type")
  @@map("kg_relation")
}

model KgFact {
  id           BigInt    @id @default(autoincrement())
  factId       String    @unique(map: "uk_kg_fact_id") @map("fact_id") @db.VarChar(64)
  tenantId     String    @default("public") @map("tenant_id") @db.VarChar(64)
  subject      String    @db.VarChar(255)
  predicate    String    @db.VarChar(255)
  object       String    @db.VarChar(512)
  validFrom    DateTime? @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  confidence   Float     @default(0.8)
  source       String?   @db.VarChar(255)
  metadataJson Json?     @map("metadata_json")
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime  @map("updated_at")

  @@index([tenantId, subject], map: "idx_kg_fact_tenant_subject")
  @@index([tenantId, predicate], map: "idx_kg_fact_tenant_predicate")
  @@index([tenantId, confidence], map: "idx_kg_fact_tenant_confidence")
  @@map("kg_fact")
}

model MemoryItem {
  id           BigInt    @id @default(autoincrement())
  memoryId     String    @unique(map: "uk_memory_item_id") @map("memory_id") @db.VarChar(64)
  tenantId     String    @default("public") @map("tenant_id") @db.VarChar(64)
  userId       String?   @map("user_id") @db.VarChar(64)
  type         String    @default("short") @db.VarChar(32)
  content      String    @db.Text
  source       String?   @db.VarChar(128)
  sourceTaskId String?   @map("source_task_id") @db.VarChar(64)
  confidence   Float     @default(0.8)
  metadataJson Json?     @map("metadata_json")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @map("created_at")
  updatedAt    DateTime  @map("updated_at")

  @@index([tenantId, userId, type], map: "idx_memory_item_tenant_user_type")
  @@index([tenantId, type], map: "idx_memory_item_tenant_type")
  @@index([expiresAt], map: "idx_memory_item_expires")
  @@index([sourceTaskId], map: "idx_memory_item_source_task")
  @@map("memory_item")
}

model MemoryEvent {
  id           BigInt   @id @default(autoincrement())
  eventId      String   @unique(map: "uk_memory_event_id") @map("event_id") @db.VarChar(64)
  memoryId     String   @map("memory_id") @db.VarChar(64)
  action       String   @db.VarChar(32)
  reason       String?  @db.VarChar(512)
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @map("created_at")

  @@index([memoryId], map: "idx_memory_event_memory")
  @@index([createdAt], map: "idx_memory_event_created")
  @@map("memory_event")
}

model EvalDataset {
  id            BigInt   @id @default(autoincrement())
  datasetId     String   @map("dataset_id") @db.VarChar(64)
  tenantId      String   @default("public") @map("tenant_id") @db.VarChar(64)
  name          String   @db.VarChar(128)
  description   String?  @db.VarChar(512)
  baselineRunId String?  @map("baseline_run_id") @db.VarChar(64)
  createdAt     DateTime @map("created_at")
  updatedAt     DateTime @map("updated_at")

  @@unique([tenantId, datasetId], map: "uk_eval_dataset_tenant_dataset")
  @@index([tenantId, updatedAt], map: "idx_eval_dataset_tenant_updated")
  @@map("eval_dataset")
}

model EvalCase {
  id                    BigInt   @id @default(autoincrement())
  caseId                String   @map("case_id") @db.VarChar(64)
  datasetId             String   @map("dataset_id") @db.VarChar(64)
  tenantId              String   @default("public") @map("tenant_id") @db.VarChar(64)
  category              String?  @db.VarChar(64)
  chatId                String?  @map("chat_id") @db.VarChar(128)
  questionText          String   @map("question_text") @db.Text
  expectedCitationsJson String?  @map("expected_citations_json") @db.Text
  expectedKeywordsJson  String?  @map("expected_keywords_json") @db.Text
  forbiddenKeywordsJson String?  @map("forbidden_keywords_json") @db.Text
  sortOrder             Int      @default(0) @map("sort_order")
  createdAt             DateTime @map("created_at")
  updatedAt             DateTime @map("updated_at")

  @@unique([tenantId, datasetId, caseId], map: "uk_eval_case_tenant_dataset_case")
  @@index([tenantId, datasetId, sortOrder], map: "idx_eval_case_tenant_dataset")
  @@map("eval_case")
}

model EvalRun {
  id                      BigInt    @id @default(autoincrement())
  runId                   String    @map("run_id") @db.VarChar(64)
  datasetId               String    @map("dataset_id") @db.VarChar(64)
  tenantId                String    @default("public") @map("tenant_id") @db.VarChar(64)
  status                  String    @db.VarChar(32)
  modelProfile            String    @default("balanced") @map("model_profile") @db.VarChar(32)
  totalCases              Int       @default(0) @map("total_cases")
  passedCases             Int       @default(0) @map("passed_cases")
  runScore                Float     @default(0) @map("run_score")
  retrievalHitRate        Float     @default(0) @map("retrieval_hit_rate")
  citationCoverageRate    Float     @default(0) @map("citation_coverage_rate")
  answerFaithfulnessScore Float     @default(0) @map("answer_faithfulness_score")
  avgLatencyMs            Float     @default(0) @map("avg_latency_ms")
  failureRate             Float     @default(0) @map("failure_rate")
  errorMessage            String?   @map("error_message") @db.VarChar(1024)
  startedAt               DateTime? @map("started_at")
  finishedAt              DateTime? @map("finished_at")
  createdAt               DateTime  @map("created_at")
  updatedAt               DateTime  @map("updated_at")

  @@unique([tenantId, runId], map: "uk_eval_run_tenant_run")
  @@index([tenantId, datasetId, createdAt], map: "idx_eval_run_tenant_dataset_created")
  @@map("eval_run")
}

model EvalResult {
  id               BigInt   @id @default(autoincrement())
  resultId         String   @map("result_id") @db.VarChar(64)
  runId            String   @map("run_id") @db.VarChar(64)
  datasetId        String   @map("dataset_id") @db.VarChar(64)
  caseId           String   @map("case_id") @db.VarChar(64)
  tenantId         String   @default("public") @map("tenant_id") @db.VarChar(64)
  status           String   @db.VarChar(32)
  questionText     String   @map("question_text") @db.Text
  answerText       String?  @map("answer_text") @db.LongText
  citationsJson    String?  @map("citations_json") @db.Text
  evidenceJson     String?  @map("evidence_json") @db.Text
  retrievalHit     Float    @default(0) @map("retrieval_hit")
  citationCoverage Float    @default(0) @map("citation_coverage")
  keywordScore     Float    @default(0) @map("keyword_score")
  answerFaithfulness Float  @default(0) @map("answer_faithfulness")
  score            Float    @default(0)
  latencyMs        BigInt   @default(0) @map("latency_ms")
  errorMessage     String?  @map("error_message") @db.VarChar(1024)
  createdAt        DateTime @map("created_at")

  @@unique([tenantId, resultId], map: "uk_eval_result_tenant_result")
  @@index([tenantId, runId, id], map: "idx_eval_result_tenant_run")
  @@index([tenantId, datasetId, caseId], map: "idx_eval_result_tenant_dataset_case")
  @@map("eval_result")
}

model KnowledgeChunk {
  id           BigInt   @id @default(autoincrement())
  chunkId      String   @unique(map: "uk_knowledge_chunk_id") @map("chunk_id") @db.VarChar(128)
  tenantId     String   @default("public") @map("tenant_id") @db.VarChar(64)
  chatId       String   @map("chat_id") @db.VarChar(128)
  jobId        String   @map("job_id") @db.VarChar(64)
  fileName     String   @map("file_name") @db.VarChar(255)
  sourceType   String   @map("source_type") @db.VarChar(32)
  chunkIndex   Int      @map("chunk_index")
  content      String   @db.LongText
  metadataJson Json?    @map("metadata_json")
  vectorJson   Json?    @map("vector_json")
  createdAt    DateTime @map("created_at")
  updatedAt    DateTime @map("updated_at")

  @@unique([tenantId, jobId, chunkIndex], map: "uk_knowledge_chunk_tenant_job_index")
  @@index([tenantId, chatId, chunkIndex], map: "idx_knowledge_chunk_tenant_chat")
  @@index([tenantId, sourceType], map: "idx_knowledge_chunk_tenant_source")
  @@map("knowledge_chunk")
}

model HarnessEvent {
  id          BigInt   @id @default(autoincrement())
  eventId     String   @unique(map: "uk_harness_event_id") @map("event_id") @db.VarChar(64)
  action      String   @db.VarChar(64)
  source      String   @db.VarChar(64)
  status      String   @db.VarChar(32)
  latencyMs   BigInt   @default(0) @map("latency_ms")
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @map("created_at")

  @@index([action, status], map: "idx_harness_event_action_status")
  @@index([createdAt], map: "idx_harness_event_created")
  @@map("harness_event")
}
