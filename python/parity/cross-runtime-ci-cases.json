  {
    "label": "session upsert",
    "method": "PUT",
    "path": "/ai/sessions/contract-session",
    "body": {
      "id": "contract-session",
      "title": "Contract session",
      "updatedAt": 1700000000000,
      "modelProfile": "balanced",
      "streaming": true,
      "pinned": false,
      "archived": false,
      "workspaceId": "default",
      "activeBranchId": "contract-target",
      "branches": [
        {
          "id": "contract-source",
          "title": "Source branch",
          "updatedAt": 1700000000000,
          "messages": [
            {
              "id": "source-shared",
              "role": "user",
              "content": "shared contract message",
              "createdAt": 1700000000000,
              "state": "done"
            },
            {
              "id": "source-only",
              "role": "user",
              "content": "source only message",
              "createdAt": 1700000000001,
              "state": "done"
            }
          ],
          "traceSteps": []
        },
        {
          "id": "contract-target",
          "title": "Target branch",
          "updatedAt": 1700000000000,
          "messages": [
            {
              "id": "target-shared",
              "role": "user",
              "content": "shared contract message",
              "createdAt": 1700000000000,
              "state": "done"
            },
            {
              "id": "target-only",
              "role": "assistant",
              "content": "target only message",
              "createdAt": 1700000000001,
              "state": "done"
            }
          ],
          "traceSteps": []
        }
      ]
    },
    "expectStatus": 200,
    "fields": [
      "id",
      "title",
      "workspaceId",
      "activeBranchId",
      "branches"
    ]
  },
